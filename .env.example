# ===========================================
# EAJMUSIC BACKEND - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=5001

# Database (PostgreSQL en tu servidor Proxmox)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://eajmusic_user:TU_PASSWORD_SEGURO@tu-ip-publica-o-dominio:5432/eajmusic_db?schema=public"

# JWT Authentication
JWT_SECRET="genera-un-secret-muy-largo-y-seguro-aqui-minimo-64-caracteres"
# Access token is short-lived by design - it lives in the eajmusic_token
# cookie sent on every request. The refresh token (eajmusic_refresh cookie)
# is long-lived and only used against POST /api/auth/refresh.
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Cookie domain for httpOnly auth cookies (eajmusic_token/eajmusic_refresh/
# eajmusic_csrf). Only applied in production (NODE_ENV=production) so the
# cookies are shared across eajmusic.com/artist.eajmusic.com/eaj.eajmusic.com;
# in development the cookie is host-only (no Domain attribute), since
# Secure cookies aren't sent by browsers over plain http://localhost anyway.
COOKIE_DOMAIN=".eajmusic.com"

# Bcrypt
BCRYPT_ROUNDS=12

# File Upload storage chain (see src/routes/upload.js storeUploadedFile):
# 1. MinIO (self-hosted, S3-compatible, primary) - src/services/minioStorageService.js
# 2. Google Drive via n8n (fallback if MinIO is down/unconfigured) - src/services/n8nFileService.js
# 3. Local disk (final fallback; also where MinIO/Drive fall through if
#    neither is configured at all, matching pre-migration behavior)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=52428800

# MinIO - systemd service on the same box (see /etc/systemd/system/minio.service),
# bound to localhost only, not exposed publicly. Leave unset to skip MinIO and
# fall through to Google Drive / local disk.
# MINIO_ENDPOINT="http://127.0.0.1:9000"
# MINIO_ROOT_USER="tu-access-key"
# MINIO_ROOT_PASSWORD="tu-secret-key"
# MINIO_BUCKET="eajmusic-uploads"

# URLs (actualiza con tus dominios)
FRONTEND_URL="https://eajmusic.com"
API_URL="https://api.eajmusic.com"

# Email (SendGrid, Mailgun, o SMTP)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="noreply@eajmusic.com"
SMTP_PASS="tu-password-smtp"
EMAIL_FROM="EAJMUSIC <noreply@eajmusic.com>"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS (dominios permitidos, separados por coma)
CORS_ORIGINS="https://eajmusic.com,https://www.eajmusic.com,https://artist.eajmusic.com,https://eaj.eajmusic.com,http://localhost:3000"

# ATH Móvil (see src/services/athMovilService.js)
# ATH_MOVIL_PUBLIC_TOKEN="tu-public-token"
# ATH_MOVIL_PRIVATE_TOKEN="tu-private-token"
# ATH_MOVIL_ENVIRONMENT="sandbox"
# ATH_MOVIL_TIMEOUT=15000
# Shared secret appended to the webhook callback URL registered with ATH
# Móvil (?secret=... or X-Webhook-Secret header) - stopgap authenticity
# check until ATH Móvil's real webhook signing scheme is confirmed. Without
# real docs from ATH Móvil, this is NOT a substitute for verified signature
# validation; see the TODO in src/routes/payment.js.
# ATH_MOVIL_WEBHOOK_SECRET="genera-un-secreto-aleatorio-largo"

# n8n Outgoing Webhooks (see src/services/n8nWebhookService.js)
# Base URL for the existing n8n automation instance. The backend fires
# fire-and-forget notification pings here after key events (testimonial
# submitted, payout requested, release submitted for review) so staff get
# notified without polling the admin panel. n8n's convention is one
# distinct webhook path per workflow, so this is a base URL + per-event
# suffix path, e.g. "${N8N_WEBHOOK_BASE_URL}/testimonial-submitted".
# Leave unset to disable n8n notifications entirely (no-op, safe default).
# N8N_WEBHOOK_BASE_URL="https://n8n.eajmusic.com/webhook"

{
  "name": "EAJMusic - Amuse.io Data Sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 * * *"
            }
          ]
        }
      },
      "name": "Daily Schedule",
      "type": "n8n-nodes-base.schedule",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.amuse.io/v1/artist/stats",
        "authentication": "headerAuth",
        "headerParametersUi": {
          "parameter": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.AMUSE_API_KEY }}"
            }
          ]
        }
      },
      "name": "Fetch Amuse Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const stats = items[0].json;\n\nreturn {\n  json: {\n    totalStreams: stats.streams_total,\n    walletBalance: stats.balance_usd,\n    topTracks: stats.top_tracks.map(t => ({\n      title: t.name,\n      streams: t.plays\n    })),\n    lastUpdated: new Date().toISOString()\n  }\n};"
      },
      "name": "Format Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://eajmusic-api.com/webhooks/update-stats",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "data",
              "value": "={{ $json }}"
            }
          ]
        }
      },
      "name": "Push to App DB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        850,
        300
      ]
    }
  ],
  "connections": {
    "Daily Schedule": {
      "main": [
        [
          {
            "node": "Fetch Amuse Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Amuse Data": {
      "main": [
        [
          {
            "node": "Format Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Data": {
      "main": [
        [
          {
            "node": "Push to App DB",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
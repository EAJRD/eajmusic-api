# ==============================================================================
# EAJMUSIC - Hardened .htaccess Configuration
# Domain: eajmusic.com (Root & Subdirectory Isolation)
# ==============================================================================

# 1. MIME Types Configuration
<IfModule mod_mime.c>
  # Scripts
  AddType application/javascript .js .mjs
  AddCharset utf-8 .js .mjs

  # Stylesheets
  AddType text/css .css
  AddCharset utf-8 .css

  # Web Data & Manifests
  AddType application/json .json
  AddType application/manifest+json .webmanifest

  # Fonts
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType application/font-woff .woff
  AddType application/font-woff2 .woff2
  AddType font/ttf .ttf
  AddType font/otf .otf

  # Images & Media
  AddType image/svg+xml .svg .svgz
  AddType image/webp .webp
  AddType image/avif .avif
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType image/x-icon .ico
  AddType audio/wav .wav
  AddType audio/flac .flac
  AddType audio/mpeg .mp3
</IfModule>

# 2. Strict Security Headers & Cache-Control
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://api-api.eajmusic.com https://*.insforge.app https://static.cloudflareinsights.com; img-src 'self' data: blob: https:; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; frame-ancestors 'none'"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

  # Cache-Control: SPA Entry Point vs Immutable Assets
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </Files>

  <FilesMatch "\.(js|mjs|css|woff2|woff|ttf|otf|png|jpe?g|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# 3. Routing & Subdirectory Protection
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pass-through for isolated subdirectories (artist and eaj apps)
  RewriteRule ^(artist|eaj)(/.*)?$ - [L]

  # Bypass index.html directly
  RewriteRule ^index\.html$ - [L]

  # Existing files, directories, or symlinks are served directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d [OR]
  RewriteCond %{REQUEST_FILENAME} -l
  RewriteRule ^ - [L]

  # NEVER rewrite missing static assets or files under /assets/ to index.html (return 404 instead of 200 text/html)
  RewriteCond %{REQUEST_URI} ^/assets/ [NC,OR]
  RewriteCond %{REQUEST_URI} \.(?:js|mjs|css|json|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|otf|map|wav|flac|mp3)$ [NC]
  RewriteRule ^ - [R=404,L]

  # SPA deep routes fallback to /index.html
  RewriteRule ^ index.html [L]
</IfModule>
